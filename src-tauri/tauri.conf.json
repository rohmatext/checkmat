{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CheckMat",
  "version": "0.1.0",
  "identifier": "com.checkmat.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CheckMat",
        "width": 480,
        "height": 600,
        "minWidth": 320,
        "minHeight": 320,
        "maxWidth": 480,
        "maxHeight": 600,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
